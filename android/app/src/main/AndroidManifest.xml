<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 위젯이 폰 위치의 날씨를 보여주려고 씀 -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- 앱을 안 열어도 위젯이 바뀐 위치를 알 수 있게 ("항상 허용"일 때만) -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- "곧 비가 와요" 알림 (안드로이드 13 이상은 허용을 물어봐요) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- 날담 사이트가 이 앱의 것임을 확인하는 정보 (주소창 없이 꽉 찬 화면으로 열리게) -->
        <meta-data
            android:name="asset_statements"
            android:resource="@string/asset_statements" />

        <!-- 앱 화면: 날담 웹사이트를 크롬으로 꽉 차게 띄움 -->
        <activity
            android:name=".NaldamLauncher"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/LaunchTheme">
            <meta-data
                android:name="android.support.customtabs.trusted.DEFAULT_URL"
                android:value="@string/launch_url" />
            <meta-data
                android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR"
                android:resource="@color/page_bg" />
            <meta-data
                android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR"
                android:resource="@color/page_bg" />
            <meta-data
                android:name="android.support.customtabs.trusted.FALLBACK_STRATEGY"
                android:value="customtabs" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="ieumnest-blip.github.io"
                    android:pathPrefix="/Naldam"
                    android:scheme="https" />
            </intent-filter>
        </activity>

        <!-- 날담 화면이 위치를 물으면, 앱이 대신 폰에 위치 허용을 받아서 넘겨줘요 -->
        <service
            android:name=".DelegationService"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.support.customtabs.trusted.TRUSTED_WEB_ACTIVITY_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
        <activity
            android:name="com.google.androidbrowserhelper.locationdelegation.PermissionRequestActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- 위젯 새로고침 + 위치 허용을 받는 투명한 화면 -->
        <activity
            android:name=".RefreshActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="false"
            android:taskAffinity=""
            android:theme="@style/TransparentTheme" />

        <!-- 위젯 꾸미기 (위젯을 길게 누르고 '설정') -->
        <activity
            android:name=".WidgetSettingsActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="날담 위젯 꾸미기"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- 홈 화면 위젯 -->
        <receiver
            android:name=".NaldamWidget"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/naldam_widget_info" />
        </receiver>
    </application>
</manifest>
